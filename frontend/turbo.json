{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "//#quality:check": {
      "outputs": [],
      "cache": false
    },
    "build": {
      "dependsOn": ["^build", "//#quality:check"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "lib/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    }
  }
}
